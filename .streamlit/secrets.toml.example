# 이 파일을 복사해서 secrets.toml 로 만들고 실제 값을 채우세요.
# secrets.toml 은 절대 깃헙에 올라가지 않습니다 (.gitignore 처리됨).

# Claude API 키 (영수증 자동 추출용)
anthropic_api_key = "sk-ant-xxxxxxxx"

# 추출에 쓸 모델 (기본값이면 이 줄 지워도 됨)
model = "claude-sonnet-5"

# 데이터를 저장할 구글 시트 ID
# 시트 주소 .../spreadsheets/d/<이 부분>/edit 의 가운데 값
sheet_id = "여기에_새_시트_ID"

# 월 목표금액 (게이지용)
monthly_goal = 4500000

# 구글 서비스 계정 인증 (구글 클라우드에서 받은 JSON 내용)
[gcp_service_account]
type = "service_account"
project_id = "xxxx"
private_key_id = "xxxx"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "xxxx@xxxx.iam.gserviceaccount.com"
client_id = "xxxx"
token_uri = "https://oauth2.googleapis.com/token"
